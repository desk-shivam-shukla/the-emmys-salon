---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReserveSchedule from '../../components/ReserveSchedule.astro';
import { isLocale, localized, localePath, t, type Locale } from '../../lib/i18n';
import { availability, salon } from '../../lib/loadData';

export function getStaticPaths() {
  return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
if (!lang || !isLocale(lang)) {
  return Astro.redirect(`${import.meta.env.BASE_URL}ja/reserve/`);
}
const locale = lang as Locale;
const hotpepper = salon.hotpepperUrl ?? '#';
const googleForm = salon.googleFormUrl ?? '#';
---
<BaseLayout locale={locale} title={t(locale, 'reserve.title')} home={false} pathSuffix="reserve/">
  <div class="bg-surface-base pb-24 pt-28 md:pt-32">
    <div class="container-site min-w-0 max-w-5xl">
      <p class="label-caps label-caps-on-light">{t(locale, 'reserve.title')}</p>
      <h1 class="section-title mt-3">{t(locale, 'reserve.subtitle')}</h1>

      <p class="mt-4 text-sm text-wood-mid">{localized(locale, salon.hours)}</p>
      <p class="text-sm text-wood-mid">{localized(locale, salon.holidays)}</p>

      <ReserveSchedule
        locale={locale}
        schedule={salon.schedule}
        availability={availability}
        googleFormUrl={salon.googleFormUrl}
      />

      <div class="card-elevated mt-12 p-8">
        <h2 class="font-serif text-xl text-wood-deep">{t(locale, 'reserve.call')}</h2>
        <a href={`tel:${salon.phone.replace(/-/g, '')}`} class="mt-3 block font-serif text-4xl text-gold-accent">
          {salon.phone}
        </a>
        <p class="mt-3 text-sm text-wood-mid">{localized(locale, salon.receptionNotes)}</p>
      </div>

      <div class="card-elevated mt-12 p-8" id="book-online">
        <h2 class="font-serif text-2xl text-wood-deep">{t(locale, 'reserve.onlineTitle')}</h2>
        <p class="mt-2 text-sm text-wood-mid">{t(locale, 'reserve.onlineNote')}</p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          {
            salon.hotpepperUrl && (
              <a
                href={hotpepper}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline-dark inline-flex flex-1 justify-center sm:flex-none sm:min-w-[14rem]"
              >
                {t(locale, 'reserve.online')}
              </a>
            )
          }
          {
            salon.googleFormUrl && (
              <a
                href={googleForm}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline-dark inline-flex flex-1 justify-center sm:flex-none sm:min-w-[14rem]"
              >
                {t(locale, 'reserve.googleForm')}
              </a>
            )
          }
        </div>
      </div>

      <p class="mt-16">
        <a
          href={localePath(locale, '')}
          class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold-accent hover:text-gold-hover"
        >
          ← {t(locale, 'reserve.backHome')}
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
