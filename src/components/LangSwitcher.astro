---
import type { Locale } from '../lib/i18n';
import { localePath, t } from '../lib/i18n';

interface Props {
  locale: Locale;
  pathSuffix?: string;
  variant?: 'light' | 'dark';
}
const { locale, pathSuffix = '', variant = 'light' } = Astro.props;
const isDark = variant === 'dark';
---
<div class="flex items-center gap-2 text-[0.65rem] uppercase tracking-[0.15em]">
  <a
    href={localePath('ja', pathSuffix)}
    class:list={[
      'px-1.5 py-0.5 transition-colors',
      locale === 'ja'
        ? isDark
          ? 'text-gold-accent'
          : 'text-wood-deep'
        : isDark
          ? 'text-cream/50 hover:text-gold-accent'
          : 'text-wood-mid hover:text-gold-accent',
    ]}
    aria-current={locale === 'ja' ? 'true' : undefined}
  >
    {t('ja', 'lang.ja')}
  </a>
  <span class={isDark ? 'text-cream/25' : 'text-gold-soft'} aria-hidden="true">/</span>
  <a
    href={localePath('en', pathSuffix)}
    class:list={[
      'px-1.5 py-0.5 transition-colors',
      locale === 'en'
        ? isDark
          ? 'text-gold-accent'
          : 'text-wood-deep'
        : isDark
          ? 'text-cream/50 hover:text-gold-accent'
          : 'text-wood-mid hover:text-gold-accent',
    ]}
    aria-current={locale === 'en' ? 'true' : undefined}
  >
    {t('en', 'lang.en')}
  </a>
</div>
