---
import type { Locale } from '../lib/i18n';
import { localized, localePath, t } from '../lib/i18n';
import { salon } from '../lib/loadData';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="bg-surface-dark text-cream">
  <div class="container-site flex flex-col gap-10 py-16 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-serif text-3xl tracking-wide">{salon.name[locale]}</p>
      <p class="text-muted-on-dark mt-3 max-w-sm text-sm leading-relaxed text-cream/55">
        {localized(locale, salon.tagline)}
      </p>
    </div>
    <div class="text-right text-sm">
      <a
        href={`tel:${salon.phone.replace(/-/g, '')}`}
        class="font-serif text-2xl text-gold-accent hover:text-gold-hover"
      >
        {salon.phone}
      </a>
      <p class="text-muted-on-dark mt-2 text-cream/50">{localized(locale, salon.hours)}</p>
      <a
        href={localePath(locale, 'reserve/')}
        class="btn-outline mt-6 inline-flex !border-cream/30 !text-cream hover:!border-gold-accent"
      >
        {t(locale, 'nav.reserve')}
      </a>
    </div>
  </div>
  <div class="hairline opacity-30"></div>
  <p class="text-muted-on-dark py-6 text-center text-[0.65rem] uppercase tracking-[0.25em] text-cream/35">
    © {year} {salon.name[locale]}
  </p>
</footer>
