---
import { getCollection } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { localePath, t } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const allNews = await getCollection('news');
const posts = allNews
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<section id="news" class="section-pad border-y border-gold-soft/40 bg-surface-elevated">
  <div class="container-site">
    <SectionHeading title={t(locale, 'news.title')} subtitle={t(locale, 'news.subtitle')} align="left" />
    {
      posts.length === 0 ? (
        <p class="text-wood-mid">—</p>
      ) : (
        <ul class="divide-y divide-gold-soft/40 border-y border-gold-soft/40">
          {posts.map((post) => (
            <li class="reveal flex flex-col gap-2 py-6 md:flex-row md:items-center md:justify-between md:gap-8">
              <div>
                <time class="label-caps" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString(locale === 'ja' ? 'ja-JP' : 'en-US')}
                </time>
                <h3 class="mt-2 font-serif text-xl text-wood-deep md:text-2xl">{post.data.title[locale]}</h3>
                <p class="mt-1 max-w-xl text-sm text-wood-mid">{post.data.excerpt[locale]}</p>
              </div>
              <a
                href={localePath(locale, `news/${post.slug}/`)}
                class="shrink-0 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold-accent hover:text-gold-hover"
              >
                {t(locale, 'news.readMore')} →
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
