---
import '../styles/global.css';
import type { Locale } from '../lib/i18n';
import { salon } from '../lib/loadData';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  home?: boolean;
  pathSuffix?: string;
}
const { locale, title, description, home = false, pathSuffix = '' } = Astro.props;
const pageTitle = title ? `${title} | ${salon.name[locale]}` : salon.name[locale];
const pageDescription = description ?? salon.tagline[locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <link rel="canonical" href={canonical.href} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    <NavBar locale={locale} home={home} pathSuffix={pathSuffix} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    {
      home && (
        <script>
          import '../scripts/spa-motion.ts';
        </script>
      )
    }
  </body>
</html>
